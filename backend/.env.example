APP_NAME=KamalPharMédis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kamalpharmedis
DB_USERNAME=kamalpharmedis
DB_PASSWORD=kamalpharmedis

# --- Cache / session / files ----------------------------------------------
SESSION_DRIVER=array
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- JWT (php-open-source-saver/jwt-auth) -----------------------------------
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60

# --- CORS : origines autorisées à appeler l'API depuis le navigateur -------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

MAIL_MAILER=log
