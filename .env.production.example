# Modèle du fichier .env du SERVEUR DE PRODUCTION (à copier en ".env" sur le serveur uniquement).
# Ne jamais committer le vrai .env : il contient les clés secrètes du site.
#
# 1. cp .env.production.example .env
# 2. sh scripts/generer-secrets.sh      (remplit DB_PASSWORD, APP_KEY et JWT_SECRET)
# 3. compléter SITE_URL et les emails ci-dessous
# 4. docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# 5. créer le compte administrateur :
#    docker compose -f docker-compose.yml -f docker-compose.prod.yml exec backend php artisan kpm:staff --role=admin

# --- Adresse publique du site (avec https://, sans / final) ---------------------
SITE_URL=https://kamalpharmedis.sn

# --- Clés secrètes : générées sur le serveur par scripts/generer-secrets.sh --------
# Ne pas les modifier ensuite : changer DB_PASSWORD bloque l'accès à la base existante,
# changer APP_KEY / JWT_SECRET déconnecte tous les utilisateurs.
DB_DATABASE=kamalpharmedis
DB_USERNAME=kamalpharmedis
DB_PASSWORD=
APP_KEY=
JWT_SECRET=

# --- Next.js (relative : passe par nginx) ----------------------------------------
NEXT_PUBLIC_API_URL=/api

# --- Emails (Gmail + mot de passe d'application Google) ------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=kamalpharmedis@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=kamalpharmedis@gmail.com
# true dès que l'envoi d'emails fonctionne : le client confirme son adresse avant d'accéder à son espace
EMAIL_VERIFICATION_REQUIRED=true

# --- Paiement en ligne PayDunya (laisser vide tant que le compte n'est pas validé) ----
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live

# --- Paiement manuel Wave / Orange Money ---------------------------------------------
MANUAL_PAYMENT_WAVE=+221 70 464 12 81
MANUAL_PAYMENT_ORANGE_MONEY=+221 75 661 62 62
