# Modèle du fichier .env du SERVEUR DE PRODUCTION (à copier en ".env" sur le serveur uniquement).
# Ne jamais committer le vrai .env : il contient les clés secrètes du site.
#
# 1. cp .env.production.example .env
# 2. sh scripts/generer-secrets.sh      (remplit DB_PASSWORD, APP_KEY et JWT_SECRET)
# 3. compléter SITE_DOMAIN, LETSENCRYPT_EMAIL et MAIL_PASSWORD ci-dessous
# 4. sh scripts/activer-https.sh         (démarre le site et obtient le certificat HTTPS)
# 5. créer le compte administrateur :
#    docker compose -f docker-compose.yml -f docker-compose.prod.yml exec backend php artisan kpm:staff --role=admin

# --- Nom de domaine du site (sans https:// ni www) ---------------------------------
# Le site répond sur https://SITE_DOMAIN ; www.SITE_DOMAIN y est redirigé.
SITE_DOMAIN=kamalpharmedis.sn
# Adresse prévenue par Let's Encrypt en cas de problème de renouvellement du certificat
LETSENCRYPT_EMAIL=kamalpharmedis@gmail.com

# --- Clés secrètes : générées sur le serveur par scripts/generer-secrets.sh --------
# Ne pas les modifier ensuite : changer DB_PASSWORD bloque l'accès à la base existante,
# changer APP_KEY / JWT_SECRET déconnecte tous les utilisateurs.
DB_DATABASE=kamalpharmedis
DB_USERNAME=kamalpharmedis
DB_PASSWORD=
APP_KEY=
JWT_SECRET=

# --- Next.js (relative : passe par nginx) ----------------------------------------
NEXT_PUBLIC_API_URL=/api

# --- Emails (Gmail + mot de passe d'application Google) ------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=kamalpharmedis@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=kamalpharmedis@gmail.com
# true dès que l'envoi d'emails fonctionne : le client confirme son adresse avant d'accéder à son espace
EMAIL_VERIFICATION_REQUIRED=true

# --- Paiement en ligne PayDunya (laisser vide tant que le compte n'est pas validé) ----
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live

# --- Paiement manuel Wave / Orange Money ---------------------------------------------
# false = seul le paiement à la livraison est proposé (espèces, ou Wave / Orange Money au livreur).
# true  = le client peut aussi payer avant la livraison par transfert et déclarer sa référence.
MOBILE_MONEY_ENABLED=false
MANUAL_PAYMENT_WAVE=+221 70 464 12 81
MANUAL_PAYMENT_ORANGE_MONEY=+221 75 661 62 62

# --- Compteur de clients affiché sur le site ------------------------------------------
# Clients déjà servis hors du site (boutique, téléphone), ajoutés aux clients inscrits.
# N'indiquer qu'un nombre réel : le compteur public doit rester exact.
CLIENTS_BASE=0

# --- Sauvegardes automatiques (dossier sauvegardes/ du serveur) -----------------------
# Heure de la sauvegarde quotidienne (heure du Sénégal = UTC) et nombre de jours conservés
SAUVEGARDE_HEURE=03:00
SAUVEGARDE_JOURS=14
