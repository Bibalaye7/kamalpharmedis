# Variables utilisées par docker-compose.yml
# Copier ce fichier en ".env" à la racine du projet avant de lancer "docker compose up"

# --- MySQL -------------------------------------------------------------------
MYSQL_DATABASE=kamalpharmedis
MYSQL_USER=kamalpharmedis
MYSQL_PASSWORD=kamalpharmedis
MYSQL_ROOT_PASSWORD=root

# --- phpMyAdmin ----------------------------------------------------------------
PMA_PORT=8080

# --- Laravel -------------------------------------------------------------------
# Ne JAMAIS committer de vraies valeurs ici — ce fichier sert uniquement d'exemple.
# APP_KEY : générée avec php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# JWT_SECRET : générée avec php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
JWT_SECRET=

# --- Next.js -------------------------------------------------------------------
# URL de l'API appelée depuis le NAVIGATEUR (jamais l'URL interne du réseau Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Emails (confirmation d'inscription, mot de passe oublié) -----------------------
# Sans envoi réel, aucun client ne peut confirmer son compte : à configurer avant la mise en ligne.
# Option 1 — SMTP (ex. Gmail avec un « mot de passe d'application » Google, jamais le vrai mot de passe) :
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=votre.adresse@gmail.com  MAIL_PASSWORD=<mot de passe d'application>
#   MAIL_FROM_ADDRESS=votre.adresse@gmail.com
# Option 2 — API Mailtrap (nécessite un domaine d'envoi vérifié) : MAIL_MAILER=mailtrap  MAILTRAP_API_KEY=...
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAILTRAP_API_KEY=
# Confirmation d'email à l'inscription : false = inscription directe, true = lien à cliquer (exige un envoi d'emails fonctionnel)
EMAIL_VERIFICATION_REQUIRED=false
