# Variables utilisées par docker-compose.yml
# Copier ce fichier en ".env" à la racine du projet avant de lancer "docker compose up"

# --- MySQL -------------------------------------------------------------------
MYSQL_DATABASE=kamalpharmedis
MYSQL_USER=kamalpharmedis
MYSQL_PASSWORD=kamalpharmedis
MYSQL_ROOT_PASSWORD=root

# --- phpMyAdmin ----------------------------------------------------------------
PMA_PORT=8080

# --- Laravel -------------------------------------------------------------------
# Ne JAMAIS committer de vraies valeurs ici — ce fichier sert uniquement d'exemple.
# APP_KEY : générée avec php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# JWT_SECRET : générée avec php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
JWT_SECRET=

# --- Next.js -------------------------------------------------------------------
# URL de l'API appelée depuis le NAVIGATEUR (jamais l'URL interne du réseau Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
